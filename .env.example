# =============================================================================
# VideoStudio Terpadu — contoh konfigurasi environment untuk fitur AI (opt-in)
#
# Cara pakai:
#   cp .env.example .env      # lalu isi key Anda di .env
#
# CATATAN:
#   • File .env (berisi rahasia) SUDAH di-.gitignore — jangan pernah di-commit.
#   • Semua fitur AI bersifat opsional. Tanpa key, pipeline tetap jalan normal
#     (fallback ke deteksi momen heuristik / tanpa pembersihan AI).
# =============================================================================

# Provider AI default untuk --ai-moments / --ai-clean (pilihan: gemini | groq)
AI_PROVIDER=gemini

# --- Google Gemini (free tier) -------------------------------------------------
# Buat API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (opsional) model Gemini; default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (free tier) ----------------------------------------------------------
# Buat API key gratis di: https://console.groq.com/keys
GROQ_API_KEY=
# (opsional) model Groq; default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
